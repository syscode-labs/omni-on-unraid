# Omni provider endpoint and service account key.
# Generate key:
#   omnictl --context <context> serviceaccount create infra-provider:libvirt --role InfraProvider --use-user-role=false
OMNI_ENDPOINT=https://omni.example.internal:443
OMNI_SERVICE_ACCOUNT_KEY=
OMNI_PROVIDER_ID=libvirt

# Libvirt provider connection.
OMNI_PROVIDER_LIBVIRT_URI=qemu+libssh://omniops@libvirt-host.example.internal/system?known_hosts_verify=ignore
OMNI_PROVIDER_SSH_KEY_FILE=/abs/path/to/provider/id_rsa
