# Omni release tag from github.com/siderolabs/omni
OMNI_VERSION=v1.5.8

# Public endpoint used by clients
OMNI_DOMAIN=omni.example.internal

# TLS mode:
# - direct: Omni serves TLS directly
# - caddy-sni: Caddy terminates TLS with per-host certs and proxies to Omni on 127.0.0.1:8443
OMNI_TLS_MODE=direct

# Data path on host
OMNI_DATA_DIR=./data

# Optional: custom registry mirror/proxy
# OMNI_IMAGE_REGISTRY=

# IaC/operator inputs
# Libvirt URI used by Terraform
# Example (set for your environment): qemu+tcp://<libvirt-host>/system
OMNI_LIBVIRT_URI=

# Libvirt storage pool for VM disks (must point to persistent storage, e.g. /mnt/user/domains/omni-vm)
# Defaults to "default" which may be ephemeral — set this to avoid losing the VM disk on reboot
OMNI_LIBVIRT_POOL=default

# Optional: libvirt pool on the host that already contains the base image (avoids uploading from operator machine)
# OMNI_LIBVIRT_BASE_IMAGE_POOL=omni-images

# Libvirt network/bridge used by VM NIC (use br0 for direct LAN IP)
OMNI_LIBVIRT_BRIDGE=br0
# Optional fixed VM NIC MAC (keeps cloud-init netplan MAC match stable across replacement)
# OMNI_VM_MAC=52:54:00:8e:74:fb

# VM domain name in libvirt
OMNI_VM_NAME=omni-vm

# Path to VM base image on libvirt host (absolute path on libvirt host filesystem)
OMNI_BASE_IMAGE_PATH=

# Local operator path used by Terraform when importing base image into libvirt
OMNI_LOCAL_BASE_IMAGE_PATH=./.cache/images/ubuntu-noble-cloudimg-amd64.qcow2

# Optional URL for automatic image preparation task
OMNI_BASE_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img

# Optional SSH target used to place/check image on remote libvirt host (user@host)
# If unset, image checks/download run locally.
OMNI_LIBVIRT_IMAGE_SSH_TARGET=

# Path to SSH public key file on operator machine
OMNI_SSH_PUBLIC_KEY_PATH=

# Optional private key path for SSH operations (defaults to OMNI_SSH_PUBLIC_KEY_PATH without .pub)
# OMNI_SSH_IDENTITY_FILE=

# Optional custom SSH options for deploy (space-separated ssh CLI options)
# OMNI_SSH_OPTS=-o BatchMode=yes -o StrictHostKeyChecking=no

# Optional, if you want VM bootstrap to join Tailscale
OMNI_TAILSCALE_AUTHKEY=
OMNI_TAILSCALE_HOSTNAME=omni

# Optional Tailscale identity used by Caddy SNI mode
# OMNI_TS_DOMAIN=omni.example.ts.net
# OMNI_TS_IP=100.x.y.z
# OMNI_PUBLIC_DOMAIN=omni.example.internal

# In caddy-sni mode, Caddy gets *.ts.net certs from host tailscaled natively.
# The Caddy container mounts /var/run/tailscale/tailscaled.sock for that.
# If Talos boot assets need to trust the same certificate Caddy serves on the
# machine API listener, point Omni at the mounted Tailscale cert files.
# OMNI_TLS_CERT_FILE=/opt/omni/generated/certs/tailscale.crt
# OMNI_TLS_KEY_FILE=/opt/omni/generated/certs/tailscale.key

# Required for caddy-sni: public cert/key copied from local machine to VM
# OMNI_TLS_PUBLIC_CERT_FILE=/abs/path/omni.example.internal/fullchain.pem
# OMNI_TLS_PUBLIC_KEY_FILE=/abs/path/omni.example.internal/privkey.pem
# If unset, deploy defaults to: ${OMNI_TLS_CERT_LOCAL_DIR}/certificates/${OMNI_DOMAIN}.crt|.key

# Optional local ACME DNS-01 issuance settings (used by scripts/issue-cert.sh)
# OMNI_TLS_ACME_EMAIL=admin@example.internal
# OMNI_TLS_ACME_DNS_PROVIDER=cloudflare
# OMNI_TLS_ACME_SANS=omni-alt.example.internal
# OMNI_TLS_CERT_LOCAL_DIR=./.cache/tls
# OMNI_TLS_RENEW_BEFORE_DAYS=30
# Extra SANs for the self-signed Omni machine API cert, useful only when
# SideroLink is not fronted by the Tailscale certificate.
# OMNI_TLS_EXTRA_SANS=192.0.2.10,omni.example.internal

# Remote deploy defaults
OMNI_SSH_USER=omni
# Optional override. If unset, deploy target is auto-discovered from libvirt VM IP.
# OMNI_SSH_TARGET=
OMNI_REMOTE_DIR=/opt/omni
# Relay staging path on jump host (when relay mode is used)
OMNI_JUMP_STAGE_DIR=/tmp/omni-deploy-src
# Comma-separated target IP prefixes requiring relay via OMNI_LIBVIRT_IMAGE_SSH_TARGET
OMNI_DEPLOY_RELAY_IP_PREFIXES=192.168.122.

# Optional Omni compose overrides used by scripts/build-compose-env.sh
# OMNI_IMG_TAG=v1.5.8
# OMNI_NAME=omni
# OMNI_EVENT_SINK_PORT=8091
# OMNI_BIND_ADDR=0.0.0.0:443
# In caddy-sni mode, the default machine API bind address is 127.0.0.1:8092
# and Caddy terminates public TLS on :8090.
# OMNI_MACHINE_API_BIND_ADDR=0.0.0.0:8090
# OMNI_K8S_PROXY_BIND_ADDR=0.0.0.0:8100
# OMNI_ADVERTISED_API_URL=https://omni.example.internal
# OMNI_ADVERTISED_K8S_PROXY_URL=https://omni.example.internal:8100/
# Prefer the Tailscale DNS name for the SideroLink API URL. Omni's WireGuard
# advertised address is ip:port, so use the Tailscale IP, not a LAN IP.
# OMNI_SIDEROLINK_API_URL=https://omni.example.ts.net:8090/
# OMNI_WG_ADDR=100.x.y.z:50180
# Omni must authorize the same identity Pocket-ID returns in the OIDC id token.
# OMNI_INITIAL_USER_EMAILS=admin@example.internal
# OMNI_ADMIN_EMAIL=admin@example.internal
# REQUIRED: set one auth provider argument set (Auth0/OIDC/SAML)
# Pocket-ID side must match templates/pocket-id-omni-oidc-client.sql:
# - confidential client (is_public=false)
# - PKCE disabled (pkce_enabled=false)
# - callback URL https://<omni-domain>/oidc/consume, not /authenticate
# OMNI_AUTH_ARGS=--auth-oidc-enabled=true --auth-oidc-provider-url=https://auth.example.internal --auth-oidc-client-id=omni --auth-oidc-client-secret=... --auth-oidc-scopes=openid,email,profile
# Persist Omni primary control-plane state in embedded etcd.
# SQLite is still configured on persistent secondary storage because Omni uses
# that path for supporting state, but it is not the primary storage kind.
# OMNI_STORAGE_KIND=etcd
# OMNI_ETCD_EMBEDDED=true
# OMNI_ETCD_EMBEDDED_DB_PATH=/_out/etcd
# OMNI_STORAGE_SQLITE_PATH=/_out/secondary-storage/omni.sqlite
# Optional: point Omni at an on-prem Image Factory. Required for custom
# extension schematics such as syscode-labs/talos-ext-firecracker.
# OMNI_IMAGE_FACTORY_ADDRESS=https://factory.example.internal
# Required when rendering generated/image-factory/config.yaml.
# OMNI_IMAGE_FACTORY_REGISTRY=ghcr.io
# OMNI_IMAGE_FACTORY_NAMESPACE=syscode-labs/image-factory
# Runtime paths inside the Image Factory container.
# OMNI_IMAGE_FACTORY_SIGNING_KEY_PATH=/keys/cache-signing.key
# OMNI_IMAGE_FACTORY_COSIGN_PUBLIC_KEY_PATH=/keys/cosign.pub
# Host files mounted to the runtime paths above.
# Generate signing key: openssl ecparam -name prime256v1 -genkey -noout -out cache-signing.key
# Generate cosign keypair in the talos-ext-firecracker publishing flow and mount the public key here.
# OMNI_IMAGE_FACTORY_SIGNING_KEY_FILE=/opt/omni/image-factory/cache-signing.key
# OMNI_IMAGE_FACTORY_COSIGN_PUBLIC_KEY_FILE=/opt/omni/image-factory/cosign.pub
# GHCR write token for Image Factory artifact pushes. Keep out of Git.
# OMNI_IMAGE_FACTORY_GITHUB_TOKEN=
# Optional Docker config alternative to GITHUB_TOKEN.
# OMNI_IMAGE_FACTORY_DOCKER_CONFIG=/opt/omni/image-factory/docker-config.json
# OMNI_IMAGE_FACTORY_TAG=latest
# OMNI_EXTRA_ARGS=

# Optional values consumed by `omni-render` for environment-specific manifests.
# OMNI_PROVIDER_LIBVIRT_URI=qemu+libssh://omniops@libvirt-host.example.internal/system?known_hosts_verify=ignore
# OMNI_OIDC_CALLBACK_URLS=https://omni.example.internal/oidc/consume
# OMNI_OIDC_LOGOUT_CALLBACK_URLS=https://omni.example.internal/
