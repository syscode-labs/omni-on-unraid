#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true

users:
  - name: ${ssh_username}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
  - gnupg
  - docker.io
  - docker-compose-v2
  - qemu-guest-agent

%{ if provider_nic_mac != "" }
# The libvirt provider in this VM talks to the host libvirtd over the default
# NAT network. Tailscale policy routing would swallow that subnet, so pin a
# policy route that only exempts the provider NAT subnet. runcmd re-applies
# this after package upgrades touch networkd; netplan is idempotent.
write_files:
  - path: /etc/netplan/60-omni-provider.yaml
    content: |
      network:
        version: 2
        ethernets:
          ens8:
            match:
              macaddress: ${provider_nic_mac}
            dhcp4: true
            routes:
              - to: ${provider_network_subnet}
                metric: ${provider_route_metric}
            routing-policy:
              - to: ${provider_network_subnet}
                priority: ${provider_policy_priority}
%{ endif }

runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now docker
%{ if provider_nic_mac != "" }
  - netplan apply
%{ endif }
  - curl -fsSL https://tailscale.com/install.sh | sh
  - systemctl enable --now tailscaled
  - |
      if [ -n "${tailscale_authkey}" ]; then
        tailscale up --auth-key "${tailscale_authkey}" --hostname "${tailscale_hostname}" --ssh
      fi
  - mkdir -p /opt/omni
  - chown -R ${ssh_username}:${ssh_username} /opt/omni
