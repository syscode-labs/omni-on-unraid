#!/bin/bash
# libvirt network hook — keep specific tailnet-bound Talos VM traffic
# UN-masqueraded so the tailnet ACL (<VM_SUBNET> -> dst) matches the real VM
# source IP instead of the host's.
#
# Without this, libvirt SNATs VMs to the host tailscale IP, which the ACL
# grants don't cover for these destinations. See the plans-repo findings doc
# 2026-07-16-libvirt-unraid-lab-tailnet-join.md (Omni join) and
# add-metallb-lan-exposure design.md (wrt-london BGP peering).
#
# Install on the libvirt host at /etc/libvirt/hooks/network (chmod +x). On
# Unraid /etc/libvirt is the persistent libvirt.img; libvirtd rescans hooks at
# boot and fires "started" when the default net autostarts. Idempotent.
net="$1"; op="$2"
VM_SUBNET="192.168.122.0/24"
EXEMPT_IPS=(
  "100.72.134.50"   # omni — SideroLink join
  "100.125.63.88"   # wrt-london — BGP peering (add-metallb-lan-exposure)
)
if [ "$net" = "default" ] && { [ "$op" = "started" ] || [ "$op" = "plugged" ] || [ "$op" = "updated" ]; }; then
  for ip in "${EXEMPT_IPS[@]}"; do
    iptables -t nat -C LIBVIRT_PRT -s "$VM_SUBNET" -d "$ip" -j RETURN 2>/dev/null \
      || iptables -t nat -I LIBVIRT_PRT 1 -s "$VM_SUBNET" -d "$ip" -j RETURN
  done
fi
exit 0
